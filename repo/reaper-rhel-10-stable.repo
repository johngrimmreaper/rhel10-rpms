[reaper-rhel-10-stable]
name=Reaper RHEL 10 RPM Repository - rhel-10 - stable
baseurl=https://johngrimmreaper.github.io/rhel10-rpms/stable/rhel/10/$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://johngrimmreaper.github.io/rhel10-rpms/RPM-GPG-KEY
metadata_expire=6h
skip_if_unavailable=0
